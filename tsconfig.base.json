{
	"compilerOptions": {
		"target": "ES2023",
		"rewriteRelativeImportExtensions": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	}
}
